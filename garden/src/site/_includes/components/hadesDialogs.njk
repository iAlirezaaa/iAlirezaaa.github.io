<dialog class="garden-dialog search-dialog" id="garden-search" aria-labelledby="search-heading">
  <div class="dialog-heading"><h2 id="search-heading">جست‌وجو در نوشته‌ها</h2><button type="button" class="icon-button" data-dialog-close aria-label="بستن جست‌وجو">×</button></div>
  <label class="sr-only" for="garden-search-input">عنوان، موضوع یا عبارت دلخواه</label><input id="garden-search-input" type="search" placeholder="عنوان، موضوع یا یک عبارت…" autocomplete="off" enterkeyhint="search" aria-controls="garden-search-results">
  <p id="garden-search-status" role="status" aria-live="polite">در متن مقاله‌ها و یادداشت‌ها جست‌وجو کن.</p>
  <ul id="garden-search-results" class="search-results" aria-label="نتیجه‌های جست‌وجو"></ul>
  <footer class="search-shortcuts"><span><kbd>↑ ↓</kbd> انتخاب</span><span><kbd>Enter</kbd> خواندن</span><span><kbd>Esc</kbd> بستن</span></footer>
</dialog>
<dialog class="garden-dialog settings-dialog" id="garden-settings" aria-labelledby="settings-heading">
  <div class="dialog-heading"><h2 id="settings-heading">ظاهر و خواندن</h2><button type="button" class="icon-button" data-dialog-close aria-label="بستن تنظیمات">×</button></div>
  <form class="reading-settings" method="dialog">
    <label for="garden-theme">ظاهر صفحه<select id="garden-theme" data-setting="theme"><option value="system">طبق تنظیم دستگاه</option><option value="light">روشن</option><option value="dark">تیره</option></select></label>
    <label for="garden-size">اندازهٔ متن<select id="garden-size" data-setting="size"><option value="small">کوچک</option><option value="regular">معمولی</option><option value="large">درشت</option><option value="extra">خیلی درشت</option></select></label>
    <div class="settings-footer"><button type="button" data-settings-reset>بازگرداندن پیش‌فرض‌ها</button><span role="status" data-settings-status>انتخاب‌ها در همین مرورگر ذخیره می‌شوند.</span></div>
  </form>
</dialog>
<dialog class="garden-dialog graph-dialog" id="garden-graph" aria-labelledby="graph-heading">
  <div class="dialog-heading"><h2 id="graph-heading">گراف نوشته‌ها</h2><button type="button" class="icon-button" data-dialog-close aria-label="بستن گراف">×</button></div>
  <p class="sr-only" data-graph-count role="status"></p>
  <div class="global-graph" data-global-graph aria-label="گراف همهٔ نوشته‌ها"></div>
  <footer class="graph-footer"><p data-graph-detail aria-live="polite">برای جابه‌جایی بکش؛ برای خواندن، یک نقطه را انتخاب کن.</p><div class="graph-actions"><button type="button" data-graph-zoom="in" aria-label="بزرگ‌نمایی گراف">+</button><button type="button" data-graph-zoom="out" aria-label="کوچک‌نمایی گراف">−</button><button type="button" data-graph-reset>بازنشانی</button></div></footer>
</dialog>
<div id="garden-link-preview" class="link-preview" role="tooltip" hidden><strong></strong><p></p></div>
