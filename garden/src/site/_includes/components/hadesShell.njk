{% set isDirectory = contentClasses == 'blog-directory' %}
<!doctype html>
<html lang="fa" dir="rtl" data-theme="system" data-size="regular" data-measure="regular" data-leading="regular">
<head>
<title>{{ title or page.fileSlug }} | وبلاگ هادس</title>
{% include "components/pageheader.njk" %}
{% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.head %}{% include imp %}{% endfor %}
</head>
<body class="hades-garden markdown-preview-view markdown-rendered{% if isDirectory %} is-directory{% endif %}" data-garden-page="{{ page.url }}">
<a class="skip-link" href="#content">رفتن به محتوای اصلی</a>
{% if not isDirectory %}<progress class="reading-progress" id="reading-progress" max="100" value="0" aria-label="پیشرفت مطالعه"></progress>{% endif %}
<header class="garden-topbar">
  <div class="topbar-start"><button type="button" class="icon-button mobile-tree-toggle" data-panel-open="navigation" aria-controls="garden-navigation" aria-expanded="false" aria-label="باز کردن فهرست وبلاگ"><span aria-hidden="true">☰</span></button><a class="topbar-name" href="/fa/blog/">وبلاگ <bdi>هادس</bdi></a></div>
  <nav class="topbar-links" aria-label="بخش‌های سایت"><a href="/fa/blog/">همهٔ نوشته‌ها</a><a href="/fa/blog/categories/">بخش‌های وبلاگ</a><a href="/fa/blog/tags/">موضوع‌ها</a><a href="/fa/work/">آثار</a></nav>
  <div class="topbar-actions"><button type="button" class="icon-button" data-search-open aria-label="جست‌وجو در نوشته‌ها و یادداشت‌ها"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button type="button" class="icon-button" data-settings-open aria-label="تنظیمات خواندن"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M9 3v6M15 9v6M9 15v6"/></svg></button>{% if not isDirectory %}<button type="button" class="icon-button mobile-context-toggle" data-panel-open="context" aria-controls="garden-context" aria-expanded="false" aria-label="فهرست مطالب و پیوندهای این صفحه"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg></button>{% endif %}</div>
</header>
<nav class="workspace-ribbon" data-workspace-ribbon hidden aria-label="ابزارهای فضای کار">
  <button type="button" data-workspace-toggle="navigation" aria-controls="garden-navigation" aria-pressed="true" aria-label="نمایش کاوشگر" title="کاوشگر"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM8 5v14M11 9h6M11 13h6"/></svg></button>
  <button type="button" data-search-open aria-label="جست‌وجو در دانش" title="جست‌وجو"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
  <button type="button" data-global-graph-open aria-haspopup="dialog" aria-label="نمای کامل گراف" title="گراف دانش"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 7 6 5 6-7M12 12l6 7M12 12l-6 6"/><circle cx="6" cy="7" r="2"/><circle cx="18" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="19" r="2"/><circle cx="6" cy="18" r="2"/></svg></button>
  <a href="/fa/blog/tags/" aria-label="موضوع‌ها" title="موضوع‌ها"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3 5 21M17 3l-3 18M3 9h18M2 15h18"/></svg></a>
  <a href="/fa/blog/categories/" aria-label="بخش‌ها" title="بخش‌ها"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="6" rx="1"/><rect x="14" y="14" width="7" height="6" rx="1"/></svg></a>
  {% if not isDirectory %}<button type="button" class="ribbon-context" data-workspace-toggle="context" aria-controls="garden-context" aria-pressed="true" aria-label="نمایش پنل ارتباط‌ها" title="پنل ارتباط‌ها"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M16 5v14M6 9h7M6 13h7"/></svg></button>{% endif %}
  <a class="ribbon-home" href="/fa/" aria-label="سایت هادس" title="سایت هادس"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3zM9 20v-6h6v6"/></svg></a>
</nav>
<div class="garden-layout">
  {% include "components/hadesNavigation.njk" %}
  <main class="content garden-content cm-s-obsidian {{ contentClasses }}" id="content" tabindex="-1">
    <nav class="workspace-strip" aria-label="فضای مطالعه">
      <a href="/fa/blog/"{% if blogIndex %} aria-current="page"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg><span>همهٔ نوشته‌ها</span></a>
      <a href="/fa/blog/#notes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7"/></svg><span>یادداشت‌ها</span></a>
      <button type="button" data-global-graph-open aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 7 6 5 6-7M12 12l6 7M12 12l-6 6"/><circle cx="6" cy="7" r="2"/><circle cx="18" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="19" r="2"/><circle cx="6" cy="18" r="2"/></svg><span>نقشهٔ دانش</span></button>
      {% if not blogIndex %}<span class="workspace-current" aria-current="page" title="{{ title or page.fileSlug }}">{{ title or page.fileSlug }}</span>{% endif %}
    </nav>
    <section class="workspace-pane-tools" data-workspace-panes hidden aria-label="تنظیم فضای مطالعه">
      <button type="button" data-workspace-focus aria-pressed="false">حالت تمرکز</button>
      <details><summary>تنظیم پنل‌ها</summary>
        <div class="workspace-pane-fields">
          <button type="button" data-workspace-toggle="navigation" aria-controls="garden-navigation" aria-pressed="true">کاوشگر نوشته‌ها</button>
          <label for="workspace-explorer-width">عرض کاوشگر <output data-workspace-value="navigation"></output></label>
          <input type="range" id="workspace-explorer-width" data-workspace-width="navigation" min="180" max="300" step="10" value="230">
          {% if not isDirectory %}<div class="workspace-context-options">
            <button type="button" data-workspace-toggle="context" aria-controls="garden-context" aria-pressed="true">پنل ارتباط‌ها</button>
            <label for="workspace-context-width">عرض ارتباط‌ها <output data-workspace-value="context"></output></label>
            <input type="range" id="workspace-context-width" data-workspace-width="context" min="180" max="280" step="10" value="240">
          </div>{% endif %}
          <button type="button" data-workspace-reset>بازنشانی پنل‌ها</button>
        </div>
      </details>
    </section>
    <header class="note-header">
      <nav class="note-breadcrumb" aria-label="مسیر صفحه"><a href="/fa/blog/">وبلاگ هادس</a><span aria-hidden="true">/</span>{% if categoryURL %}<a href="{{ categoryURL }}">{{ categoryLabel or group }}</a>{% else %}<span>{{ group or 'یادداشت‌ها' }}</span>{% endif %}</nav>
      <h1>{{ title or page.fileSlug }}</h1>
      {% if description %}<p class="note-description">{{ description }}</p>{% endif %}
      {% if not isDirectory %}<div class="note-meta"><span class="article-byline">علیرضا عسگرپور</span>{% if updated or date %}<span aria-hidden="true">·</span><time class="persian-date" datetime="{{ (updated or date) | hadesISODate }}">{{ (updated or date) | hadesDate }}</time>{% endif %}<span class="reading-time" data-reading-time{% if readingMinutes %} data-reading-minutes="{{ readingMinutes }}"{% endif %}>{% if readingMinutes %}· {{ readingMinutes | hadesNumber }} دقیقه مطالعه{% endif %}</span></div>{% endif %}
      {% if tags and settings.dgShowTags !== false %}<div class="note-tags" aria-label="موضوع‌های این یادداشت">{% for tag in tags %}{% if tag != 'gardenEntry' and tag != 'note' %}<button type="button" data-search-query="{{ tag }}">{{ tag }}</button>{% endif %}{% endfor %}</div>{% endif %}
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
    </header>
    {% if not isDirectory %}
      {% set inlineTocHtml = content and (content | hideDataview | link | toc) %}
      {% if inlineTocHtml %}<details class="reader-inline-toc"><summary>در این صفحه</summary><div class="toc-container" data-toc>{{ inlineTocHtml | safe }}</div></details>{% endif %}
    {% endif %}
    {% if blogIndex %}<section class="recent-reading" data-recent-reading hidden aria-labelledby="recent-reading-title"><header><div><h2 id="recent-reading-title">بازگشت به مطالعه</h2><p data-recent-status></p></div><a href="#reading-history-title" data-recent-manage>تنظیم تاریخچه</a></header><ol data-recent-visits></ol></section>{% endif %}
    {% if blogIndex %}<section class="atlas-preview-section" aria-labelledby="atlas-preview-title"><header class="atlas-preview-header"><div><span class="atlas-kicker" lang="en" dir="ltr">KNOWLEDGE ATLAS</span><h2 id="atlas-preview-title">نقشهٔ دانش</h2><p>ارتباط واقعی میان مقاله‌ها و یادداشت‌های وبلاگ.</p></div><button type="button" data-global-graph-open>کاوش در نقشه ↗</button></header><div class="atlas-preview" data-atlas-preview aria-label="پیش‌نمایش نقشهٔ دانش"><p class="muted">در حال دریافت ارتباط‌ها…</p></div><div class="atlas-preview-inspector"><p data-atlas-count role="status"></p><p data-atlas-detail aria-live="polite">برای دیدن عنوان کامل، یک نود را انتخاب کن.</p></div><p class="atlas-legend"><span><i class="atlas-article" aria-hidden="true"></i>مقاله</span><span><i aria-hidden="true"></i>یادداشت</span><span>عنوان‌های متراکم هوشمندانه پنهان می‌شوند.</span></p><noscript><p>نقشه به جاوااسکریپت نیاز دارد؛ نوشته‌ها در فهرست زیر قابل دسترسی هستند.</p></noscript></section>{% endif %}
    <article class="note-body" id="prose" data-note-body>
    {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
    {{ content | hideDataview | taggify | link | resolveMdLinks(page.inputPath) | safe }}

    {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
    </article>
    {% if not isDirectory %}<section class="trail-panel" data-reading-related hidden aria-labelledby="reading-related-title"><h2 id="reading-related-title">ادامهٔ مطالعه</h2><p>پیوندهای واقعی این نوشته در نقشهٔ دانش، بدون ترتیب اجباری؛ پیوندهای دوسویه یک‌بار نمایش داده می‌شوند.</p><div class="trail-filter"><label for="reading-relation">نوع ارتباط</label><select id="reading-relation" data-reading-relation><option value="all">همهٔ ارتباط‌ها</option><option value="mutual">دوسویه</option><option value="outgoing">فقط خروجی</option><option value="incoming">فقط ورودی</option></select><p role="status" data-reading-count></p></div><div class="trail-grid"><div data-reading-group><h3>پیوندهای این نوشته</h3><ul data-reading-out></ul></div><div data-reading-group><h3>پیوندهای ورودی دیگر</h3><ul data-reading-in></ul></div></div></section>{% endif %}
    {% if blogIndex or not isDirectory %}<section class="trail-panel" data-reading-history hidden aria-labelledby="reading-history-title"><h2 id="reading-history-title">تاریخچهٔ مطالعه</h2><p>اختیاری، فقط در همین مرورگر؛ حداکثر ۱۲ نوشته. بدون ارسال به سرور.</p><div class="trail-actions"><button type="button" data-reading-toggle aria-pressed="false">فعال کردن تاریخچه</button><button type="button" data-reading-clear>پاک کردن</button></div><p role="status" data-reading-status></p><ul data-reading-visits></ul></section>{% endif %}
    {% if not isDirectory and blogComments.threads[page.url] and not hide %}
      {% set commentIssue = blogComments.threads[page.url] %}
      <section class="blog-comments" data-blog-comments data-issue="{{ commentIssue }}" id="comments" aria-labelledby="comments-heading">
        <header><h2 id="comments-heading">دیدگاه‌ها</h2><p>پرسش، نقد و تکمیل این نوشته. دیدگاه‌ها عمومی هستند و در GitHub ذخیره می‌شوند.</p></header>
        <div class="blog-comment-actions">
          <a class="comment-write" href="https://github.com/iAlirezaaa/iAlirezaaa.github.io/issues/{{ commentIssue }}#new_comment_field" target="_blank" rel="noopener noreferrer">ثبت دیدگاه در GitHub <span aria-hidden="true">↗</span></a>
          <button type="button" data-comments-load hidden aria-controls="comment-results">نمایش دیدگاه‌ها</button>
        </div>
        <p class="comment-account">برای ثبت نظر به حساب GitHub نیاز داری. اطلاعات شخصی یا محرمانه منتشر نکن.</p>
        <p data-comments-status role="status" aria-live="polite"></p>
        <ol data-comments-list id="comment-results" hidden></ol>
      </section>
      <script type="module" src="/scripts/blog-comments.js"></script>
    {% endif %}
    <footer class="note-footer"><p>پژوهش، مفهوم، ساخت.</p><div><button type="button" data-copy-link>کپی پیوند</button><a href="#content">بازگشت به ابتدا</a><span class="copy-status" role="status" aria-live="polite"></span></div>{% if isDirectory %}<span class="review-caption">طراحی رابط · REVIEW</span>{% endif %}</footer>
  </main>
  {% if not isDirectory %}{% include "components/sidebar.njk" %}{% endif %}
</div>
<div class="garden-backdrop" data-panel-close hidden></div>
{% include "components/hadesDialogs.njk" %}
{% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.footer %}{% include imp %}{% endfor %}
{% if (contentClasses and 'canvas-page' in contentClasses) or (content and 'canvas-wrapper' in content) %}{% include "components/canvasScript.njk" %}{% endif %}
{% include "components/basesScript.njk" %}
{% include "components/excalidrawScript.njk" %}
</body>
</html>
