{% set isDirectory = contentClasses == 'blog-directory' %}
<!doctype html>
<html lang="fa" dir="rtl" data-theme="system" data-size="regular" data-measure="regular" data-leading="regular">
<head>
<title>{{ title or page.fileSlug }} | وبلاگ هادس</title>
{% include "components/pageheader.njk" %}
{% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.head %}{% include imp %}{% endfor %}
</head>
<body class="hades-garden markdown-preview-view markdown-rendered{% if isDirectory %} is-directory{% endif %}" data-garden-page="{{ page.url }}">
<a class="skip-link" href="#content">رفتن به محتوای اصلی</a>
{% if not isDirectory %}<progress class="reading-progress" id="reading-progress" max="100" value="0" aria-label="پیشرفت مطالعه"></progress>{% endif %}
<header class="garden-topbar">
  <div class="topbar-start"><button type="button" class="icon-button mobile-tree-toggle" data-panel-open="navigation" aria-controls="garden-navigation" aria-expanded="false" aria-label="باز کردن فهرست وبلاگ"><span aria-hidden="true">☰</span></button><a class="topbar-name" href="/fa/blog/">وبلاگ <bdi>هادس</bdi></a></div>
  <nav class="topbar-links" aria-label="بخش‌های سایت"><a href="/fa/blog/">همهٔ نوشته‌ها</a><a href="/fa/blog/categories/">بخش‌های وبلاگ</a><a href="/fa/blog/tags/">موضوع‌ها</a><a href="/fa/work/">آثار</a></nav>
  <div class="topbar-actions"><button type="button" class="icon-button" data-search-open aria-label="جست‌وجو در نوشته‌ها و یادداشت‌ها"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button type="button" class="icon-button" data-settings-open aria-label="تنظیمات خواندن"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M9 3v6M15 9v6M9 15v6"/></svg></button>{% if not isDirectory %}<button type="button" class="icon-button mobile-context-toggle" data-panel-open="context" aria-controls="garden-context" aria-expanded="false" aria-label="فهرست مطالب و پیوندهای این صفحه"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg></button>{% endif %}</div>
</header>
<div class="garden-layout">
  {% include "components/hadesNavigation.njk" %}
  <main class="content garden-content cm-s-obsidian {{ contentClasses }}" id="content" tabindex="-1">
    <header class="note-header">
      <nav class="note-breadcrumb" aria-label="مسیر صفحه"><a href="/fa/blog/">وبلاگ هادس</a><span aria-hidden="true">/</span>{% if categoryURL %}<a href="{{ categoryURL }}">{{ categoryLabel or group }}</a>{% else %}<span>{{ group or 'یادداشت‌ها' }}</span>{% endif %}</nav>
      <h1>{{ title or page.fileSlug }}</h1>
      {% if description %}<p class="note-description">{{ description }}</p>{% endif %}
      {% if not isDirectory %}<div class="note-meta"><span class="article-byline">علیرضا عسگرپور</span>{% if updated or date %}<span aria-hidden="true">·</span><time class="persian-date" datetime="{{ (updated or date) | hadesISODate }}">{{ (updated or date) | hadesDate }}</time>{% endif %}<span class="reading-time" data-reading-time{% if readingMinutes %} data-reading-minutes="{{ readingMinutes }}"{% endif %}>{% if readingMinutes %}· {{ readingMinutes | hadesNumber }} دقیقه مطالعه{% endif %}</span></div>{% endif %}
      {% if tags and settings.dgShowTags !== false %}<div class="note-tags" aria-label="موضوع‌های این یادداشت">{% for tag in tags %}{% if tag != 'gardenEntry' and tag != 'note' %}<button type="button" data-search-query="{{ tag }}">{{ tag }}</button>{% endif %}{% endfor %}</div>{% endif %}
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
    </header>
    {% if not isDirectory %}
      {% set inlineTocHtml = content and (content | hideDataview | link | toc) %}
      {% if inlineTocHtml %}<details class="reader-inline-toc"><summary>در این صفحه</summary><div class="toc-container" data-toc>{{ inlineTocHtml | safe }}</div></details>{% endif %}
    {% endif %}
    {% if blogIndex %}<section class="atlas-preview-section" aria-labelledby="atlas-preview-title"><header class="atlas-preview-header"><div><span class="atlas-kicker" lang="en" dir="ltr">KNOWLEDGE ATLAS</span><h2 id="atlas-preview-title">نقشهٔ دانش</h2><p>ارتباط واقعی میان مقاله‌ها و یادداشت‌های وبلاگ.</p></div><button type="button" data-global-graph-open>کاوش در نقشه ↗</button></header><div class="atlas-preview" data-atlas-preview aria-label="پیش‌نمایش نقشهٔ دانش"><p class="muted">در حال دریافت ارتباط‌ها…</p></div><div class="atlas-preview-inspector"><p data-atlas-count role="status"></p><p data-atlas-detail aria-live="polite">برای دیدن عنوان کامل، یک نود را انتخاب کن.</p></div><p class="atlas-legend"><span><i class="atlas-article" aria-hidden="true"></i>مقاله</span><span><i aria-hidden="true"></i>یادداشت</span><span>عنوان‌های متراکم هوشمندانه پنهان می‌شوند.</span></p><noscript><p>نقشه به جاوااسکریپت نیاز دارد؛ نوشته‌ها در فهرست زیر قابل دسترسی هستند.</p></noscript></section>{% endif %}
    <article class="note-body" id="prose" data-note-body>
    {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
    {{ content | hideDataview | taggify | link | resolveMdLinks | safe }}

    {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
    </article>
    <footer class="note-footer"><p>پژوهش، مفهوم، ساخت.</p><div><button type="button" data-copy-link>کپی پیوند</button><a href="#content">بازگشت به ابتدا</a><span class="copy-status" role="status" aria-live="polite"></span></div>{% if isDirectory %}<span class="review-caption">طراحی رابط · REVIEW</span>{% endif %}</footer>
  </main>
  {% if not isDirectory %}{% include "components/sidebar.njk" %}{% endif %}
</div>
<div class="garden-backdrop" data-panel-close hidden></div>
{% include "components/hadesDialogs.njk" %}
{% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.footer %}{% include imp %}{% endfor %}
{% if contentClasses and 'canvas-page' in contentClasses %}{% include "components/canvasScript.njk" %}{% endif %}
{% include "components/basesScript.njk" %}
{% include "components/excalidrawScript.njk" %}
</body>
</html>
