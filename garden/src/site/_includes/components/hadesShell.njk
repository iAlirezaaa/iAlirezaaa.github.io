{% set isDirectory = contentClasses == 'blog-directory' %}
<!doctype html>
<html lang="fa" dir="rtl" data-theme="system" data-size="regular" data-measure="regular" data-leading="regular">
<head>
<title>{{ title or page.fileSlug }} | وبلاگ هادس</title>
{% include "components/pageheader.njk" %}
{% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.head %}{% include imp %}{% endfor %}
</head>
<body class="hades-garden markdown-preview-view markdown-rendered{% if isDirectory %} is-directory{% endif %}" data-garden-page="{{ page.url }}">
<a class="skip-link" href="#content">رفتن به محتوای اصلی</a>
{% if not isDirectory %}<progress class="reading-progress" id="reading-progress" max="100" value="0" aria-label="پیشرفت مطالعه"></progress>{% endif %}
<header class="garden-topbar">
  <div class="topbar-start"><button type="button" class="icon-button mobile-tree-toggle" data-panel-open="navigation" aria-controls="garden-navigation" aria-expanded="false" aria-label="نمایش یا پنهان کردن کاوشگر" title="کاوشگر"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM8 5v14M11 9h6M11 13h6"/></svg></button><a class="topbar-name" href="/fa/blog/">وبلاگ <bdi>هادس</bdi></a></div>
  <div class="topbar-actions"><button type="button" class="icon-button" data-global-graph-open aria-haspopup="dialog" aria-label="نمای کامل گراف" title="گراف دانش"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 7 6 5 6-7M12 12l6 7M12 12l-6 6"/><circle cx="6" cy="7" r="2"/><circle cx="18" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="19" r="2"/><circle cx="6" cy="18" r="2"/></svg></button><button type="button" class="icon-button" data-search-open aria-label="جست‌وجو در نوشته‌ها و یادداشت‌ها" title="جست‌وجو"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button><button type="button" class="icon-button" data-settings-open aria-label="تنظیمات" title="تنظیمات"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M9 3v6M15 9v6M9 15v6"/></svg></button>{% if not isDirectory %}<button type="button" class="icon-button mobile-context-toggle" data-panel-open="context" aria-controls="garden-context" aria-expanded="false" aria-label="فهرست مطالب و پیوندهای این صفحه" title="ارتباط‌های نوشته"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></svg></button>{% endif %}</div>
</header>
<div class="garden-layout">
  {% include "components/hadesNavigation.njk" %}
  <main class="content garden-content cm-s-obsidian {{ contentClasses }}" id="content" tabindex="-1">
    <header class="note-header">
      {% if not isDirectory %}<p class="note-breadcrumb">{% if categoryURL %}<a href="{{ categoryURL }}">{{ categoryLabel or group }}</a>{% else %}{{ group or 'یادداشت‌ها' }}{% endif %}</p>{% endif %}
      <h1>{{ title or page.fileSlug }}</h1>
      {% if description %}<p class="note-description">{{ description }}</p>{% endif %}
      {% if not isDirectory %}<div class="note-meta"><span class="article-byline">علیرضا عسگرپور</span>{% if updated or date %}<span aria-hidden="true">·</span><time class="persian-date" datetime="{{ (updated or date) | hadesISODate }}">{{ (updated or date) | hadesDate }}</time>{% endif %}<span class="reading-time" data-reading-time{% if readingMinutes %} data-reading-minutes="{{ readingMinutes }}"{% endif %}>{% if readingMinutes %}· {{ readingMinutes | hadesNumber }} دقیقه مطالعه{% endif %}</span></div>{% endif %}
      {% if tags and settings.dgShowTags !== false %}<div class="note-tags" aria-label="موضوع‌های این یادداشت">{% for tag in tags %}{% if tag != 'gardenEntry' and tag != 'note' %}<button type="button" data-search-query="{{ tag }}">{{ tag }}</button>{% endif %}{% endfor %}</div>{% endif %}
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
    </header>
    {% if blogIndex %}<section class="atlas-preview-section" aria-labelledby="atlas-preview-title"><header class="atlas-preview-header"><div><h2 id="atlas-preview-title">نقشهٔ دانش</h2><p>نودها را بکش یا روی آن‌ها بزن.</p></div></header><div class="atlas-preview" data-atlas-preview aria-label="پیش‌نمایش نقشهٔ دانش"><p class="muted">در حال دریافت ارتباط‌ها…</p></div><div class="atlas-preview-inspector"><p data-atlas-count role="status"></p><p data-atlas-detail aria-live="polite">برای دیدن عنوان کامل، یک نود را انتخاب کن.</p></div><button type="button" class="graph-layout-reset" data-graph-layout-reset hidden>بازنشانی نودها</button><p class="atlas-legend"><span><i class="atlas-article" aria-hidden="true"></i>مقاله</span><span><i aria-hidden="true"></i>یادداشت</span><span>عنوان‌های متراکم هوشمندانه پنهان می‌شوند.</span></p><noscript><p>نقشه به جاوااسکریپت نیاز دارد؛ نوشته‌ها در فهرست زیر قابل دسترسی هستند.</p></noscript></section>{% endif %}
    <article class="note-body" id="prose" data-note-body>
    {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
    {{ content | hideDataview | taggify | link | resolveMdLinks(page.inputPath) | safe }}

    {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
    </article>
    {% if not isDirectory and blogComments.threads[page.url] and not hide %}
      {% set commentIssue = blogComments.threads[page.url] %}
      <section class="blog-comments" data-blog-comments data-issue="{{ commentIssue }}" id="comments" aria-labelledby="comments-heading">
        <header><h2 id="comments-heading">دیدگاه‌ها</h2><p>پرسش، نقد و تکمیل این نوشته. دیدگاه‌ها عمومی هستند و در GitHub ذخیره می‌شوند.</p></header>
        <div class="blog-comment-actions">
          <a class="comment-write" href="https://github.com/iAlirezaaa/iAlirezaaa.github.io/issues/{{ commentIssue }}#new_comment_field" target="_blank" rel="noopener noreferrer">ثبت دیدگاه در GitHub <span aria-hidden="true">↗</span></a>
          <button type="button" data-comments-load hidden aria-controls="comment-results">نمایش دیدگاه‌ها</button>
        </div>
        <p class="comment-account">برای ثبت نظر به حساب GitHub نیاز داری. اطلاعات شخصی یا محرمانه منتشر نکن.</p>
        <p data-comments-status role="status" aria-live="polite"></p>
        <ol data-comments-list id="comment-results" hidden></ol>
      </section>
      <script type="module" src="/scripts/blog-comments.js"></script>
    {% endif %}
    <footer class="note-footer"><p>پژوهش، مفهوم، ساخت.</p><div><button type="button" data-copy-link>کپی پیوند</button><a href="#content">بازگشت به ابتدا</a><span class="copy-status" role="status" aria-live="polite"></span></div>{% if isDirectory %}<span class="review-caption">طراحی رابط · REVIEW</span>{% endif %}</footer>
  </main>
  {% if not isDirectory %}{% include "components/sidebar.njk" %}{% endif %}
</div>
<div class="garden-backdrop" data-panel-close hidden></div>
{% include "components/hadesDialogs.njk" %}
{% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
{% for imp in dynamics.common.footer %}{% include imp %}{% endfor %}
{% if (contentClasses and 'canvas-page' in contentClasses) or (content and 'canvas-wrapper' in content) %}{% include "components/canvasScript.njk" %}{% endif %}
{% include "components/basesScript.njk" %}
{% include "components/excalidrawScript.njk" %}
</body>
</html>
