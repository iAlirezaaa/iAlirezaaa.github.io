<aside class="garden-navigation garden-panel" id="garden-navigation" aria-label="فهرست وبلاگ" data-panel="navigation">
  <div class="panel-mobile-heading"><strong>نوشته‌ها</strong><button type="button" class="icon-button" data-panel-close aria-label="بستن فهرست نوشته‌ها">×</button></div>
  <nav class="garden-sections" aria-label="موضوع‌ها و دسته‌ها"><a href="/fa/blog/categories/">بخش‌ها</a><a href="/fa/blog/tags/">موضوع‌ها</a></nav><div class="navigation-divider"></div>
  <div class="tree-heading"><h2>کاوشگر نوشته‌ها</h2><button type="button" data-tree-collapse aria-label="باز و بسته کردن بخش‌ها">جمع کردن</button></div>
  <nav class="garden-filetree" id="workspace-filetree" data-filetree aria-label="فهرست نوشته‌ها">{% include "plugins/dg-filetree/tree.njk" ignore missing %}<p class="filetree-loading">در حال دریافت فهرست…</p></nav>
  <noscript><nav class="no-script-notes" aria-label="فهرست نوشته‌ها">{% for note in collections.note | notHidden %}<a href="{{note.url}}">{{note.data.title or note.fileSlug}}</a>{% endfor %}</nav></noscript>
  <footer class="navigation-footer"><a href="/fa/">سایت هادس</a></footer>
</aside>
